# Operates only on the installed copy, preserving the developer's build tree.
set(XL_INSTALLED_LIBRARY "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_LIBDIR@/libXLWebEngineUI.so.@PROJECT_VERSION@")
if(NOT EXISTS "${XL_INSTALLED_LIBRARY}")
  message(FATAL_ERROR "Installed shared library is missing: ${XL_INSTALLED_LIBRARY}")
endif()
execute_process(COMMAND "@XL_OBJCOPY@" --strip-unneeded "${XL_INSTALLED_LIBRARY}" RESULT_VARIABLE XL_STRIP_RESULT)
if(NOT XL_STRIP_RESULT EQUAL 0)
  message(FATAL_ERROR "Failed to strip installed library debug information")
endif()
execute_process(COMMAND "@XL_OBJCOPY@" "--add-gnu-debuglink=@XL_DEBUG_FILE@" "${XL_INSTALLED_LIBRARY}"
  RESULT_VARIABLE XL_LINK_RESULT)
if(NOT XL_LINK_RESULT EQUAL 0)
  message(FATAL_ERROR "Failed to attach shared library debug link")
endif()
set(XL_INSTALLED_WEBTEST "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_BINDIR@/@XL_WEBTEST_INSTALLED_NAME@")
execute_process(COMMAND "@XL_OBJCOPY@" --strip-unneeded "${XL_INSTALLED_WEBTEST}" RESULT_VARIABLE XL_STRIP_RESULT)
if(NOT XL_STRIP_RESULT EQUAL 0)
  message(FATAL_ERROR "Failed to strip installed WebTest debug information")
endif()
execute_process(COMMAND "@XL_OBJCOPY@" "--add-gnu-debuglink=@XL_WEBTEST_DEBUG_FILE@" "${XL_INSTALLED_WEBTEST}"
  RESULT_VARIABLE XL_LINK_RESULT)
if(NOT XL_LINK_RESULT EQUAL 0)
  message(FATAL_ERROR "Failed to attach WebTest debug link")
endif()
