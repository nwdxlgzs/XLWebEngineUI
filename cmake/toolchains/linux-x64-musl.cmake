set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
get_filename_component(XL_SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(XL_MUSL_WRAPPERS "${XL_SOURCE_ROOT}/build/toolchains/wrappers/linux-musl")
if(NOT EXISTS "${XL_MUSL_WRAPPERS}/toolchain.json")
  message(FATAL_ERROR "Run python3 -B tools/bootstrap.py musl before configuring musl")
endif()
set(CMAKE_C_COMPILER "${XL_MUSL_WRAPPERS}/cc")
set(CMAKE_CXX_COMPILER "${XL_MUSL_WRAPPERS}/cxx")
set(CMAKE_AR "${XL_MUSL_WRAPPERS}/ar")
set(CMAKE_RANLIB "${XL_MUSL_WRAPPERS}/ranlib")
set(CMAKE_C_COMPILER_AR "${CMAKE_AR}")
set(CMAKE_CXX_COMPILER_AR "${CMAKE_AR}")
set(CMAKE_C_COMPILER_RANLIB "${CMAKE_RANLIB}")
set(CMAKE_CXX_COMPILER_RANLIB "${CMAKE_RANLIB}")
