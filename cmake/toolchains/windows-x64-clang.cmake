get_filename_component(XL_SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
file(READ "${XL_SOURCE_ROOT}/third_party/toolchains.lock.json" XL_TOOLCHAIN_LOCK)
string(JSON XL_LLVM_DIRECTORY GET "${XL_TOOLCHAIN_LOCK}" "llvm-windows-x64" "archive_root")
set(XL_LLVM_BIN "${XL_SOURCE_ROOT}/build/toolchains/${XL_LLVM_DIRECTORY}/bin")
if(NOT EXISTS "${XL_LLVM_BIN}/clang-cl.exe")
  message(FATAL_ERROR "Run python -B tools/bootstrap.py llvm before configuring")
endif()
set(CMAKE_C_COMPILER "${XL_LLVM_BIN}/clang-cl.exe")
set(CMAKE_CXX_COMPILER "${XL_LLVM_BIN}/clang-cl.exe")
set(CMAKE_LINKER "${XL_LLVM_BIN}/lld-link.exe")
set(CMAKE_AR "${XL_LLVM_BIN}/llvm-lib.exe")
